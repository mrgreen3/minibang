URxvt.font: xft:DejaVu Sans Mono:size=10
URxvt.scrollBar: false
URxvt.cursorBlink: true

! Share one urxvtd process across all terminal windows
URxvt.perl-ext-common: default,matcher
URxvt.urlLauncher: w3m

! MiniBang theme — single source of truth for terminal + i3 + dmenu.
! i3/dmenu pull these via `set_from_resource` (see .config/i3/config) instead
! of hardcoding hex, so this file is the only place the palette is defined.
*background: #1a1d1e
*foreground: #d8d8d8
*color0:  #1a1d1e
*color1:  #e0623f
*color2:  #3fa796
*color3:  #d9a441
*color4:  #4f8fba
*color5:  #8f7fbd
*color6:  #5fb8ae
*color7:  #d8d8d8
*color8:  #55605e
*color9:  #e0623f
*color10: #3fa796
*color11: #d9a441
*color12: #4f8fba
*color13: #8f7fbd
*color14: #5fb8ae
*color15: #ffffff

! MiniBang i3/dmenu palette (custom resource names, read via set_from_resource)
*i3.background: #1a1d1e
*i3.bgAlt:      #24282a
*i3.foreground: #d8d8d8
*i3.fgDim:      #6b7280
*i3.accent:     #3fa796
*i3.urgent:     #e0623f
